# Dependencies and build output
node_modules/
dist/
coverage/
proofs/windows-workspace-boundary/**/bin/
proofs/windows-workspace-boundary/**/obj/

# Project workspaces (local-only R&D playground, never tracked except README)
project/*
!project/README.md

# Environment and IDE
.env
.DS_Store
*.log
*.code-workspace
.vscode/
.idea/

# Python virtual environment and cache (legacy cleanup)
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime artifacts - ignore these completely
.artifacts*/
artifacts*/
gate-results/
deliverables/
out*.json
.lexrunner/

# Keep test fixtures
!tests/fixtures/deliverables/

# .smartergpt runtime directories
.smartergpt/runner/
.smartergpt/gate-results/
.smartergpt/cache/
.smartergpt/deliverables/
.smartergpt/gate-results/

# Local overlay (development only, not tracked)
.smartergpt.local/

# Runtime artifacts - .lexrunner moved to .smartergpt/runner for 0.5.0+
.lexrunner/

# Benchmark results (runtime)
tests/benchmarks/results/

# Generated plan artifacts (runtime)
snapshot.md
plan-*.json

# Test files (temporary)
test-plan.json
tmp-*
test-results.json
ax-summary.json
test-summary.md

# Keep only live deliverable in VCS
!.smartergpt/deliverables/.live.md

# Keep these profile files tracked
!.smartergpt/intent.md
!.smartergpt/scope.yml
!.smartergpt/deps.yml
!.smartergpt/gates.yml
!.smartergpt/stack.yml
!.smartergpt/pull-request-template.md
*.log
*.code-workspace
.vscode/
.idea/

*real-pr-plan.json
test-artifacts/*
tool-assessment-report.md
installers/windows-helper/bin/
installers/windows-helper/obj/
