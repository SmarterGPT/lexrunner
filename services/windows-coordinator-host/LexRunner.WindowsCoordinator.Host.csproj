<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>lexrunner-windows-coordinator-host</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Source fixture only. The normal image excludes the admission bridge. -->
  <PropertyGroup Condition="'$(CoordinatorAdmissionBridgeTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COORDINATOR_ADMISSION_BRIDGE_TESTS</DefineConstants>
  </PropertyGroup>
</Project>
