<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>lexrunner-windows-coordinator-client</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CoordinatorClientFixtureTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COORDINATOR_CLIENT_FIXTURE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContract.cs" Link="SelectionCustody\CustodyContract.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\NativeRegistryReader.cs" Link="SelectionCustody\NativeRegistryReader.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContractV3.cs" Link="SelectionCustody\CustodyContractV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\NativeRegistryReaderV3.cs" Link="SelectionCustody\NativeRegistryReaderV3.cs" />
    <Compile Include="..\..\installers\windows-coordinator\v3\GraphV3.cs" Link="GraphV3\GraphV3.cs" />
  </ItemGroup>
</Project>
