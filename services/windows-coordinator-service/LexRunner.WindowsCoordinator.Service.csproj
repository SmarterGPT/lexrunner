<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>LexRunner.WindowsCoordinator.Service</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CoordinatorServiceFixtureTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COORDINATOR_SERVICE_FIXTURE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows-coordinator-selection-publisher\NativePublicationMutex.cs" Link="Publication\NativePublicationMutex.cs" />
    <Compile Include="..\windows-coordinator-selection-publisher\NativePublicationAdministration.cs" Link="Publication\NativePublicationAdministration.cs" />
    <Compile Include="..\windows-coordinator-selection-publisher\NativeProtectedPublicationStore.cs" Link="Publication\NativeProtectedPublicationStore.cs" />
    <Compile Include="..\windows-coordinator-selection-publisher\PublicationAdminEntrypoint.cs" Link="Publication\PublicationAdminEntrypoint.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\NativeRegistryReaderV3.cs" Link="SelectionCustody\NativeRegistryReaderV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\NativeInstalledPublicationReader.cs" Link="SelectionCustody\NativeInstalledPublicationReader.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContract.cs" Link="SelectionCustody\CustodyContract.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContractV3.cs" Link="SelectionCustody\CustodyContractV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\PublicationContractV3.cs" Link="SelectionCustody\PublicationContractV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\PublicationContractV3FixtureTests.cs" Link="SelectionCustody\PublicationContractV3FixtureTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="__Internal!LexRunnerVerifySelectedTrustV2" />
    <NativeLibrary Include="$(CoordinatorTrustNativeLibrary)" />
    <NativeLibrary Include="bcrypt.lib" />
    <NativeLibrary Include="crypt32.lib" />
    <NativeLibrary Include="wintrust.lib" />
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>
  <Target Name="RequireStaticTrustLibrary" BeforeTargets="IlcCompile" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="'$(CoordinatorTrustNativeLibrary)' == '' Or !Exists('$(CoordinatorTrustNativeLibrary)')"
      Text="Build the fixed native trust core before publishing this optional application; no dynamic fallback is provided." />
  </Target>
</Project>
