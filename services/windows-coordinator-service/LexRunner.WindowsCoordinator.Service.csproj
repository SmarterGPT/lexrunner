<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>LexRunner.WindowsCoordinator.Service</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CoordinatorServiceFixtureTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COORDINATOR_SERVICE_FIXTURE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContract.cs" Link="SelectionCustody\CustodyContract.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\CustodyContractV3.cs" Link="SelectionCustody\CustodyContractV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\PublicationContractV3.cs" Link="SelectionCustody\PublicationContractV3.cs" />
    <Compile Include="..\windows-coordinator-selection-custody\PublicationContractV3FixtureTests.cs" Link="SelectionCustody\PublicationContractV3FixtureTests.cs" />
  </ItemGroup>
</Project>
