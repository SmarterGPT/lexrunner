<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>LexRunner.WindowsCoordinator.SelectionPublisher</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelectionPublisherFixture)' == 'true'">
    <DefineConstants>$(DefineConstants);SELECTION_PUBLISHER_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VerifierBoundedProcess.cs" />
  </ItemGroup>
</Project>
