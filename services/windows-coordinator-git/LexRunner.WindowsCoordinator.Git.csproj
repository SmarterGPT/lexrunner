<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>LexRunner.WindowsCoordinator.Git</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GitImportFixture)' == 'true'">
    <DefineConstants>$(DefineConstants);GIT_IMPORT_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VerifierBoundedProcess.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(GitImportFixture)' == 'true'">
    <Compile Include="../../installers/windows-coordinator/v2/GraphV2.cs" Link="GraphV2.cs" />
  </ItemGroup>
</Project>
