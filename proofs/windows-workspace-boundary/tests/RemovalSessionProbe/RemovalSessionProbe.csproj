<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>lexrunner-windows-removal-session-probe</AssemblyName>
    <DefineConstants>$(DefineConstants);REMOVAL_SESSION_TESTS</DefineConstants>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/LexRunner.WindowsBoundary.Helper/*.cs" Link="Production/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
