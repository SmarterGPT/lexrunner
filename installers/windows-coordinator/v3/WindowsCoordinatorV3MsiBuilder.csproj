<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AssemblyName>WindowsCoordinatorV3MsiBuilder</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="V3MsiProgram.cs" />
    <Compile Include="GraphV3.cs" />
    <Compile Include="V3MsiRecipe.cs" />
    <Compile Include="V3MsiAudit.cs" />
    <Compile Include="V3MsiReadback.cs" />
    <Compile Include="..\v2\BoundedProcess.cs" Link="BoundedProcess.cs" />
    <Compile Include="..\NativeDatabase.cs" Link="NativeDatabase.cs" />
  </ItemGroup>
</Project>
